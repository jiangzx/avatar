# Copy to .env (git-ignored). Never commit real secrets.
PORT=8787
APP_SECRET=change-me-to-a-random-32-char-string
ADAPTER=mock
# Set ADAPTER=seeduplex only for an explicit real-model smoke; never commit this key.
# SEEDUPLEX_API_KEY=
# SEEDUPLEX_ENDPOINT=wss://openspeech.bytedance.com/api/v3/duplex/realtime/dialogue
# SEEDUPLEX_MODEL=1.2.6.1
# SEEDUPLEX_VOICE=zh_male_xiaotian_jupiter_bigtts
# SEEDUPLEX_VOICE_ZH=zh_male_xiaotian_jupiter_bigtts
# SEEDUPLEX_VOICE_EN=en_male_tim_uranus_bigtts
# Qwen alternative (requires a region/workspace-specific endpoint and DASHSCOPE_API_KEY).
# ADAPTER=qwen
# DASHSCOPE_API_KEY=
# QWEN_ENDPOINT=wss://<WorkspaceId>.cn-beijing.maas.aliyuncs.com/api-ws/v1/realtime
# QWEN_MODEL=qwen3.8-omni-flash-realtime
# QWEN_VOICE=longanlingxin
# QWEN_VOICE_ZH=longanlingxin
# QWEN_VOICE_JA=Tina
# QWEN_VOICE_EN=Tina
# QWEN_VOICE_YOUNG_MALE=Evan
# Chinese must not use Evan: it reads ～ as 横杠. Ryan does not (probe 2026-10-25).
# QWEN_VOICE_YOUNG_MALE_ZH=Ryan
# Keep the key-free summarizer default for local development. Enable only with an explicitly verified endpoint.
# SUMMARIZER=mock
# QWEN_SUMMARIZER_ENDPOINT=
# QWEN_SUMMARIZER_MODEL=qwen-flash
ALLOW_DEBUG_TEXT=1
# Comma-separated extra CORS origins for desktop debugging
DEV_ORIGINS=http://localhost:5173
# MockAdapter speech detection threshold (RMS of 16-bit PCM). Raise it if speaker echo triggers fake turns.
MOCK_SPEECH_THRESHOLD=800
# Maximum time to initialize the adapter after a WebSocket claim.
SESSION_START_TIMEOUT_MS=10000

# Device identity + memory store (Plan 3 B). Unset MEMORY_DB_PATH = dev mode (no /device/register, no memory).
# Absolute path OUTSIDE the repository; the file is created with mode 600.
# MEMORY_DB_PATH=/Users/<you>/.anyidea/memory.db
# MEMORY_DB_BUSY_TIMEOUT_MS=5000
# MAX_OWNERS=100
# REGISTER_DAILY_CAP=20
# REGISTER_RATE_LIMIT_MAX=5
# REGISTER_RATE_LIMIT_WINDOW_MS=3600000
# ORPHAN_OWNER_DAYS=7
# ORPHAN_CLEANUP_BATCH=200
# Dev-only owner deletion (DELETE /dev/owner/:id with x-dev-token). Keep off.
# ENABLE_DEV_ENDPOINTS=0
# DEV_TOKEN=
