{
  "name": "@anyidea/gateway",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development node --watch --env-file-if-exists=.env --import tsx src/index.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "admin:hash-password": "node --import tsx scripts/admin-hash-password.ts"
  },
  "dependencies": {
    "@anyidea/protocol": "*",
    "tsx": "4.23.15",
    "ws": "8.22.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/ws": "8.18.2",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
