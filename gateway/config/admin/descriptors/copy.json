      "impact": { "characters": "all", "stage": "主动开口", "effective": "next_session" },
      "control": "list", "minItems": 5, "maxItems": 10, "itemMaxChars": { "zh": 30, "ja": 60, "en": 120 },
      "complianceNote": null, "risk": "low", "riskNote": null
    },
