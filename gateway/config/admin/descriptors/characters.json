      "control": "textarea", "maxChars": { "zh": 1200, "ja": 1480, "en": 2400 }, "placeholders": "auto",
      "complianceNote": null, "risk": "high",
      "riskNote": "改坏了 AI 可能说错话。安全底线在别处，不会被这里改掉。"
    },
    {
      "key": "role:elder-companion/{lang}/director.greetingNameTexts",
      "label": "知道称呼后的开场白",
