      "control": "list", "minItems": 1, "maxItems": 5, "itemMaxChars": { "zh": 30, "ja": 50, "en": 100 },
      "requiredTokens": ["{name}"],
      "complianceNote": null, "risk": "medium",
      "riskNote": "不要写「上次您说……」这类具体的事，AI 会把没聊过的事说成聊过。"
