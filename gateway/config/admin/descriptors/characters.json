      "control": "select", "options": "voices.{lang}",
      "complianceNote": null, "risk": "medium",
      "riskNote": "换了声音，老人可能一下子认不出是谁。"
    },
    {
      "key": "role:elder-companion/{lang}/persona",
      "label": "三个角色共用的人设",
      "purpose": "AI 陪老人聊天的总体要求：怎么说话、什么不能说。三个角色都用这段。",
